{
  "_note": "Single source of truth for color, type and line weight. Every tool (Motion Canvas, Revideo, Manim, Blender, thumbnails) reads this file. See style-bible.md for the rules behind each value.",
  "color": {
    "bg": "#11151B",
    "panel": "#1A2029",
    "grid": "#262E39",
    "chalk": "#ECE7DC",
    "muted": "#8B95A3",
    "heat": "#FF7A33",
    "heat_peak": "#FF4A2B",
    "heat_soft": "#7A3A1C",
    "cold": "#3DA8F5",
    "cold_deep": "#2A6FD6",
    "cold_soft": "#173E5E",
    "refrigerant": "#B38CFF",
    "refrigerant_soft": "#4A3A6E",
    "electric": "#D6F25C"
  },
  "font": {
    "display": "Archivo",
    "display_width": "SemiCondensed",
    "mono": "IBM Plex Mono"
  },
  "type_px_1080p": {
    "title": 88,
    "label": 44,
    "small_label": 34,
    "number": 52,
    "caption": 46
  },
  "line_px_1080p": {
    "hairline": 2,
    "structure": 4,
    "emphasis": 6,
    "flow": 8
  },
  "motion": {
    "fps": 30,
    "size": [1920, 1080],
    "enter_s": 0.6,
    "exit_s": 0.4,
    "max_static_s": 8,
    "change_every_s": [4, 6]
  }
